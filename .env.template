# =============================================================================
# Sashko Music — Environment Template
# Скопіюй у .env і заповни перед деплоєм
# =============================================================================

# =============================================================================
# TELEGRAM (обов'язково)
# =============================================================================
TGBOT_NAME=
TGBOT_TOKEN=
# ID чату або групи, куди бот пише за замовчуванням
TGBOT_DEFAULT_CHAT_ID=0
# ID групи, якій дозволено використовувати бота (залиш порожнім = без обмежень)
TGBOT_ALLOWED_GROUP_ID=
# ID топіка "logs" у TGBOT_DEFAULT_CHAT_ID — туди стрімиться CLI-output скачувань (залиш порожнім = вимкнути)
TGBOT_LOGS_TOPIC_ID=
# ID топіка, куди роутиться весь процес скачування (залиш порожнім = вимкнути)
TGBOT_DOWNLOAD_TOPIC_ID=
# ID топіку в групі для повідомлень за замовчуванням
TGBOT_DEFAULT_TOPIC_ID=

# =============================================================================
# AI (обов'язково)
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# DATABASE
# =============================================================================
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =============================================================================
# PATHS — де зберігати файли на сервері
# =============================================================================
# Бібліотека музики (монтується в navidrome, slskd, audio-analyzer)
LIBRARY_ROOT_PATH=/opt/sm/lib

# Корінь для всіх завантажень
DOWNLOADS_BASE_PATH=/opt/sm/downloads

# Результати аудіо-аналізу
ANALYSIS_RESULTS_PATH=/opt/sm/analysis

# =============================================================================
# SOULSEEK (slskd)
# =============================================================================
SLSKD_API_KEY=
SLSKD_DOWNLOAD_PATH=/opt/sm/downloads/slskd

# =============================================================================
# QOBUZ
# =============================================================================
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
# Або токен замість email+password (якщо є)
QOBUZ_AUTH_TOKEN=
# Шлях до бінарника `rip` (orpheus/streamrip) всередині контейнера
QOBUZ_CLI_PATH=/usr/local/bin/rip
QOBUZ_DOWNLOAD_PATH=/opt/sm/downloads/qobuz

# =============================================================================
# APPLE MUSIC (gamdl)
# =============================================================================
# Шлях до бінарника gamdl всередині контейнера
APPLE_GAMDL_PATH=/usr/local/bin/gamdl
# Cookies файл для авторизації
APPLE_GAMDL_COOKIES=/opt/sm/downloads/apple_cookies.txt
APPLE_GAMDL_OUTPUT=/opt/sm/downloads/apple-music

# =============================================================================
# BANDCAMP
# =============================================================================
# Шлях до бінарника bandcamp-dl всередині контейнера
BANDCAMP_CLI_PATH=/usr/local/bin/bandcamp-dl
BANDCAMP_DOWNLOAD_PATH=/opt/sm/downloads/bandcamp
# Акаунт bandcamp для доступу до куплених альбомів
BANDCAMP_EMAIL=
BANDCAMP_PASSWORD=

# =============================================================================
# YOUTUBE MUSIC (yt-dlp)
# =============================================================================
YTDLP_CLI_PATH=/usr/local/bin/yt-dlp
YTDLP_DOWNLOAD_PATH=/opt/sm/downloads/ytmusic
# Cookies для AAC 256kbps (без cookies — AAC 128kbps)
YTDLP_COOKIES_PATH=/opt/sm/downloads/ytdlp_cookies.txt

# =============================================================================
# DISCOGS
# =============================================================================
DISCOGS_API_TOKEN=

# =============================================================================
# NAVIDROME
# =============================================================================
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=admin

# =============================================================================
# ICECAST
# =============================================================================
ICECAST_ADMIN_USERNAME=admin
ICECAST_ADMIN_PASSWORD=changeme
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_RELAY_PASSWORD=changeme
ICECAST_HOSTNAME=localhost
ICECAST_LOCATION=Earth
ICECAST_ADMIN_EMAIL=admin@localhost
ICECAST_MAX_CLIENTS=100
ICECAST_MAX_SOURCES=2
ICECAST_MOUNTPOINT=/stream

# =============================================================================
# PATH MAPPING (якщо шляхи всередині контейнера відрізняються від хоста)
# Потрібно для /reprocess коли шлях з БД (хостовий) треба перетворити на шлях у контейнері
# =============================================================================
# При /reprocess — замінює цей префікс...
PATH_MAPPING_REPROCESS_SOURCE=/Volumes/Music/
# ...на цей
PATH_MAPPING_REPROCESS_TARGET=/mnt/media_hdd/lib/

# При /process — замінює цей префікс...
PATH_MAPPING_PROCESS_SOURCE=/Volumes/Downloads/
# ...на цей
PATH_MAPPING_PROCESS_TARGET=/opt/sm/downloads/
